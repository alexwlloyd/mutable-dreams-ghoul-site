diff --git a/tests/render_ghoul.cpp b/tests/render_ghoul.cpp
new file mode 100644
index 0000000..00b189a
--- /dev/null
+++ b/tests/render_ghoul.cpp
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * GHOULBOX grit level and stability report: renders sounds and Biomes, writes WAVs.
+ * usage: render-ghoul [outdir] */
+#include "dsp/dreams.h"
+#include <cstdio>
+#include <cmath>
+#include <cstring>
+#include <cstdlib>
+#include <vector>
+#include <string>
+static std::vector<float> buf;
+static void wav(const std::string &path,const std::vector<float> &x){
+ FILE *f=fopen(path.c_str(),"wb");if(!f)return;unsigned n=x.size(),bytes=n*2,rate=MD_RATE,br=rate*4;unsigned short ch=2,bits=16,align=4,fmt=1;unsigned sz=36+bytes,fl=16;
+ fwrite("RIFF",1,4,f);fwrite(&sz,4,1,f);fwrite("WAVEfmt ",1,8,f);fwrite(&fl,4,1,f);fwrite(&fmt,2,1,f);fwrite(&ch,2,1,f);fwrite(&rate,4,1,f);fwrite(&br,4,1,f);fwrite(&align,2,1,f);fwrite(&bits,2,1,f);fwrite("data",1,4,f);fwrite(&bytes,4,1,f);
+ for(float v:x){short s=(short)lrintf(fmaxf(-1,fminf(1,v))*32767);fwrite(&s,2,1,f);}fclose(f);
+}
+static void run(unsigned frames,bool keep){float o[256];for(unsigned i=0;i<frames/128;i++){md_render(o,128);if(keep)buf.insert(buf.end(),o,o+256);}}
+static void report(const char *what,const std::vector<float> &x){double s=0;float pk=0;for(float v:x){s+=v*v;pk=fmaxf(pk,fabsf(v));}printf("%-28s rms %6.3f  peak %5.3f  nonfinite %u\n",what,sqrt(s/(x.size()?x.size():1)),pk,md_status()->nonfinite);}
+int main(int argc,char **argv){
+ std::string dir=argc>1?argv[1]:"";
+ // Single sounds on a blank Biome: an eight-note phrase, one track, level 500.
+ static const int ids[]={48,64,72,80,96,112,128,160,176,192,208};
+ for(int pass=0;pass<2;pass++){
+  int lo=pass?MD_GHOUL_TONE:0,hi=pass?MD_TONE_PRESETS:(int)(sizeof ids/sizeof *ids);
+  for(int k=lo;k<hi;k++){int id=pass?k:ids[k];
+   md_init();md_command(MD_SCENE,0,MD_BLANK_BIOME);md_command(MD_TONE_PRESET,0,id);md_command(MD_LEVEL,0,500);md_command(MD_MUTE,0,0);md_command(MD_ROOT,0,2);md_command(MD_SCALE,0,1);
+   buf.clear();run(256,false);
+   static const int notes[]={50,53,57,55,50,62,57,45};
+   for(int j=0;j<8;j++){md_command(MD_TRIGGER,0,md_tone_model(id)>=MD_FM?notes[j]:36+(j%2)*12);run(MD_RATE/3,true);}
+   run(MD_RATE,true);
+   char label[64];snprintf(label,sizeof label,"%3d %s/%d",id,md_tone_name(id),md_tone_model(id));report(label,buf);
+   if(!dir.empty()&&pass){char p[256];snprintf(p,sizeof p,"%s/tone-%03d.wav",dir.c_str(),id);wav(p,buf);}
+  }
+ }
+ for(int id:{0,1,12,27,65,70}){md_init();md_command(MD_SCENE,0,id);md_command(MD_PLAY,0,1);buf.clear();run(MD_RATE*12,true);char l[64];snprintf(l,sizeof l,"B%02d %s",id,md_biome_name(id));report(l,buf);}
+ for(int id=MD_GHOUL_BIOME;id<MD_BIOMES;id++){md_init();md_command(MD_SCENE,0,id);md_command(MD_PLAY,0,1);buf.clear();run(MD_RATE*20,true);char l[64];snprintf(l,sizeof l,"B%02d %s",id,md_biome_name(id));report(l,buf);
+  for(int t=0;t<6;t++)printf("   t%d peak %.3f model %d\n",t,md_status()->track_peak[t],md_state()->track[t].model);
+  if(!dir.empty()){char p[256];snprintf(p,sizeof p,"%s/biome-%02d.wav",dir.c_str(),id);wav(p,buf);}}
+}
